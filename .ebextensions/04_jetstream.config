# .ebextensions/04_jetstream.config

container_commands:
  # 01 - Generar la clave de aplicación si no existe
  01_generate_key:
    command: "php artisan key:generate --force"
    leader_only: true

  # 02 - Publicar todas las vistas de Jetstream
  02_publish_jetstream_views:
    command: "php artisan vendor:publish --tag=jetstream-views --force"
    leader_only: true

  # 03 - Publicar configuraciones de Jetstream
  03_publish_jetstream_config:
    command: "php artisan vendor:publish --tag=jetstream-config --force"
    leader_only: true

  # 04 - Ejecutar migraciones específicas de Jetstream
  04_jetstream_migrations:
    command: "php artisan migrate --force"
    leader_only: true

  # 05 - Limpiar y recargar rutas
  05_reload_routes:
    command: "php artisan route:clear && php artisan route:cache"
    leader_only: true