# .ebextensions/03_deploy.config

container_commands:
  # 01 - Instalar dependencias de Composer
  01_install_dependencies:
    command: "composer.phar install --no-dev --optimize-autoloader"
    leader_only: true

  # 02 - Instalar y configurar Jetstream
  02_install_jetstream:
    command: "php artisan jetstream:install livewire --force"
    leader_only: true

  # 03 - Publicar assets de Jetstream
  03_publish_jetstream:
    command: "php artisan vendor:publish --tag=jetstream-views"
    leader_only: true

  # 04 - Ejecutar migraciones de la base de datos
  04_run_migrations:
    command: "php artisan migrate --force"
    leader_only: true

  # 05 - Ejecutar seeders para crear usuario administrador
  05_run_seeders:
    command: "php artisan db:seed --force"
    leader_only: true

  # 06 - Limpiar toda la caché para evitar rutas 'staging' hardcodeadas
  # ¡IMPORTANTE! No caches la configuración (config:cache) aquí.
  06_clear_cache:
    command: "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear"
    leader_only: true

  # 07 - Establecer permisos correctos (propietario y grupo)
  # Esto es CRÍTICO. Se ejecuta como último comando para afectar a todos los archivos.
  07_set_permissions:
    command: "chown -R webapp:webapp storage bootstrap/cache && chmod -R 775 storage bootstrap/cache"
    leader_only: true

# Los 'hooks' se ejecutan DESPUÉS de que la aplicación se ha desplegado en /var/app/current
# Esto es ideal para comandos que necesitan la ruta final de la aplicación.
hooks:
  application:
    postdeploy:
      # 01 - Crear el enlace simbólico del storage
      # Se ejecuta como usuario webapp para asegurar el contexto y permisos correctos.
      "01_storage_link":
        command: "su -s /bin/bash webapp -c 'cd /var/app/current && php artisan storage:link'"